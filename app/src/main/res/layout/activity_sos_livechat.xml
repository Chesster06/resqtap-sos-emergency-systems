<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sos_livechat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sos_livechat_topbar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@color/bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_sos_livechat"
            style="@style/Widget.ResQTap.MapControlButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/back"
            app:icon="@drawable/ic_arrow_back_24"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/text_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_clear_sos_chat"
            app:layout_constraintStart_toEndOf="@id/btn_back_sos_livechat"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_livechat_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="SOS Live Support"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot_online"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_step_circle_done"
                    android:backgroundTint="#10B981" />

                <TextView
                    android:id="@+id/tv_livechat_responder_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Admin Responder • Active"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear_sos_chat"
            style="@style/Widget.ResQTap.MapControlButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Padam Mesej"
            app:backgroundTint="#FEE2E2"
            app:cornerRadius="999dp"
            app:icon="@drawable/ic_delete"
            app:iconPadding="0dp"
            app:iconSize="19dp"
            app:iconTint="#EF4444"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_call_from_livechat"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="#2AEF4444"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_call_from_livechat"
            style="@style/Widget.ResQTap.MapControlButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/sos_call_responder"
            app:backgroundTint="#FFE4EE"
            app:cornerRadius="999dp"
            app:icon="@drawable/ic_phone"
            app:iconPadding="0dp"
            app:iconSize="19dp"
            app:iconTint="#E60067"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="#2AE60067"
            app:strokeWidth="1dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Emergency Info Banner -->
    <LinearLayout
        android:id="@+id/banner_sos_case_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFF1F4"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sos_livechat_topbar">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="SOS"
            android:src="@drawable/ic_siren_alarm"
            app:tint="#E60067" />

        <TextView
            android:id="@+id/tv_sos_banner_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Sesi Mesej Langsung Kecemasan SOS • Berhubung Terus Dengan Admin"
            android:textColor="#BE123C"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Messages Scroll Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sos_livechat_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/typing_indicator_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/banner_sos_case_info">

        <LinearLayout
            android:id="@+id/sos_messages_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- System Welcome Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/panel"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#18E11D48"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚨 Saluran Kecemasan Aktif"
                        android:textColor="#E60067"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_welcome_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Mesej anda dihantar terus kepada responder admin yang mengendalikan kes SOS ini."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Typing Indicator View -->
    <LinearLayout
        android:id="@+id/typing_indicator_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_report_status_pill"
        android:backgroundTint="#F1F5F9"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/quick_chips_scroll"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_typing_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Responder sedang menaip..."
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Quick Emergency Reply Chips -->
    <HorizontalScrollView
        android:id="@+id/quick_chips_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/sos_composer_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_quick_1"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Responder di mana sekarang?"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeColor="#CBD5E1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_quick_2"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Berapa minit lagi sampai?"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeColor="#CBD5E1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_quick_3"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Saya berada di lokasi selamat."
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeColor="#CBD5E1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_quick_4"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Saya perlukan bantuan perubatan!"
                android:textAllCaps="false"
                android:textColor="#E60067"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeColor="#E60067" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom Composer Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sos_composer_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/panel"
        app:cardCornerRadius="24dp"
        app:cardElevation="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#18000000"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <EditText
                android:id="@+id/et_sos_chat_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Tulis mesej kecemasan..."
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sos_chat_send"
                style="@style/Widget.ResQTap.MapControlButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Send"
                app:backgroundTint="#E60067"
                app:cornerRadius="999dp"
                app:icon="@drawable/ic_send_24"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/white"
                app:strokeWidth="0dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
