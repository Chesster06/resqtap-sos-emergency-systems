<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_white_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Drag Handle / Close Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bim_detail_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_close_detail"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tts_input_action"
            android:contentDescription="Tutup"
            android:src="@drawable/ic_close_24"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Sign Illustration Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="14dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#F8FAFC">

        <ImageView
            android:id="@+id/iv_detail_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:contentDescription="@null" />
    </androidx.cardview.widget.CardView>

    <!-- Word & Translation -->
    <TextView
        android:id="@+id/tv_detail_perkataan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_detail_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/brand_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Source Badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#EFF6FF"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="Bahasa Isyarat Malaysia (BIM) • Kehidupan: Ekspresi"
        android:textColor="#2563EB"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Example Sentences (Contoh Ayat) -->
    <LinearLayout
        android:id="@+id/layout_example_sentences"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#F1F5F9"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contoh Ayat:"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_detail_contoh_ayat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_detail_example_sentence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <!-- Button: Insert into sentence transcript -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_insert_to_transcript"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/brand_primary"
            android:text="@string/bim_btn_insert_transcript"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_send_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />

        <!-- Button: Watch BIM Video on YouTube -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_watch_bim_video"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="@string/bim_watch_video"
            android:textColor="@color/brand_primary"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_videocam_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/brand_primary"
            app:strokeColor="@color/brand_primary"
            app:strokeWidth="1.5dp" />
    </LinearLayout>

</LinearLayout>
