<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sending_alarm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp">

            <!-- Siren Dial Beacon (Pulsing graphic matching app style) -->
            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="12dp">

                <!-- Dial base / Glow -->
                <ImageView
                    android:id="@+id/sending_alarm_dial_base"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:src="@drawable/bg_siren_dial_base" />

                <!-- Circular Progress Ring (Glowing Red) -->
                <com.example.resqtap.sos.CircularProgressView
                    android:id="@+id/sending_alarm_progress_dial"
                    android:layout_width="220dp"
                    android:layout_height="220dp" />

                <!-- Red Siren Icon -->
                <ImageView
                    android:id="@+id/sending_alarm_icon"
                    android:layout_width="118dp"
                    android:layout_height="118dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_siren_alarm" />
            </FrameLayout>

            <!-- Main Title: Sending Alarm -->
            <TextView
                android:id="@+id/tv_sending_alarm_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/sending_alarm_title"
                android:textColor="#FF0F172A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tv_sending_alarm_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/sending_alarm_subtitle"
                android:textColor="#FF64748B"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp" />

            <!-- Live Broadcast Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="#FFF8FAFC"
                app:cardCornerRadius="18dp"
                app:strokeColor="#FFE2E8F0"
                app:strokeWidth="1.2dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/sos_beacon_dot" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/sending_alarm_status_dispatching"
                            android:textColor="#FFE11D48"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sending_alarm_quiet_badge"
                            android:textColor="#FF059669"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#FFE2E8F0"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Live GPS Coordinates -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_ios_location"
                            app:tint="#FFE11D48" />

                        <TextView
                            android:id="@+id/tv_sending_alarm_gps_coords"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/sending_alarm_gps_locating"
                            android:textColor="#FF334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Alert Recipients -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_medical_cross"
                            app:tint="#FF3B82F6" />

                        <TextView
                            android:id="@+id/tv_sending_alarm_destinations"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/sending_alarm_destinations_loading"
                            android:textColor="#FF334155"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Admin Responder Status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_verified_user_24"
                            app:tint="#FF10B981" />

                        <TextView
                            android:id="@+id/tv_sending_alarm_admin_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/sending_alarm_admin_waiting"
                            android:textColor="#FF64748B"
                            android:textSize="12sp"
                            android:fontStyle="italic" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Action Button: Emergency Chat -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sending_alarm_open_chat"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/sending_alarm_btn_chat"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#FF2563EB"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_message_outline_24"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFFFF" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <!-- Slide to Cancel Dark Slider (Matches app's SOS bottom sheet) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sos_sheet_slide_to_cancel"
                android:textColor="#FF64748B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="54dp"
                app:cardBackgroundColor="#FF0B1220"
                app:cardCornerRadius="999dp"
                app:cardElevation="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/sos_sheet_slide_track"
                        android:textColor="#E6FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <SeekBar
                        android:id="@+id/seek_sending_alarm_cancel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:progress="0"
                        android:max="100"
                        android:splitTrack="false"
                        android:thumbOffset="0dp"
                        android:thumb="@drawable/sos_seek_thumb"
                        android:progressTint="#00000000"
                        android:progressBackgroundTint="#00000000" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
