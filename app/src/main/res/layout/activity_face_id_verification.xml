<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFC">

    <!-- ======================================================== -->
    <!-- 1. INTRO / INSTRUCTIONS SCREEN (Phase 1)                 -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/layout_intro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAFAFC"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="visible">

        <!-- Top Navigation -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/btn_intro_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_chevron_left_24"
                app:tint="@color/brand_primary" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Face Graphic Card -->
                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_face_intro_box">

                    <ImageView
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_face_entrust_guide" />
                </FrameLayout>

                <!-- Title & Subtitle -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:text="@string/face_verify_intro_title"
                    android:textColor="#191B20"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/face_verify_intro_subtitle"
                    android:textColor="#6C7280"
                    android:textSize="15sp" />

                <!-- Bullet Points -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <!-- Bullet 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:text="•"
                            android:textColor="@color/brand_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/face_verify_intro_point1"
                            android:textColor="#374151"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Bullet 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:text="•"
                            android:textColor="@color/brand_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/face_verify_intro_point2"
                            android:textColor="#374151"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="24dp" />

                <!-- Disclaimer note -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_info"
                        app:tint="#8C93A0" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/face_verify_intro_disclaimer"
                        android:textColor="#8C93A0"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Primary Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_intro_ready"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:backgroundTint="@color/brand_primary"
                    android:elevation="0dp"
                    android:text="@string/face_verify_btn_ready"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

                <!-- ResQTap Footer Branding -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/resqtap_launcher_cropped" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ResQTap Real Identity"
                        android:textColor="#A0A5B1"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- 2. SCANNING & SUCCESS SCREEN (Phase 2 & 3)               -->
    <!-- ======================================================== -->
    <!-- ======================================================== -->
    <!-- 2. SCANNING & SUCCESS SCREEN (Phase 2 & 3)               -->
    <!-- ======================================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_scan_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#16181D"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <!-- Top Navigation with Back Chevron -->
        <ImageView
            android:id="@+id/btn_scan_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_chevron_left_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFFFFF" />

        <!-- Center Oval Area (270dp x 370dp) -->
        <FrameLayout
            android:id="@+id/frame_oval_wrapper"
            android:layout_width="270dp"
            android:layout_height="370dp"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toTopOf="@+id/layout_middle_guidance"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_scan_back"
            app:layout_constraintVertical_bias="0.35"
            app:layout_constraintVertical_chainStyle="spread_inside">

            <!-- 1. Live Camera Preview in Rounded Oval (Radius = 130dp) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_oval_camera"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                app:cardBackgroundColor="#0D0E11"
                app:cardCornerRadius="130dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextureView
                    android:id="@+id/scan_camera_texture"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Dimming overlay for success transition -->
                <View
                    android:id="@+id/view_dim_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#80000000"
                    android:visibility="gone" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Oval Border Glow / Track with Progressive Arcs -->
            <com.example.resqtap.security.OvalProgressView
                android:id="@+id/view_oval_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="4dp" />

            <!-- 3. Success Green Checkmark Badge (Phase 3) -->
            <FrameLayout
                android:id="@+id/layout_success_badge"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_check_circle_green"
                android:elevation="6dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check_bold"
                    app:tint="#00E676" />
            </FrameLayout>
        </FrameLayout>

        <!-- Middle Guidance: Precisely Centered Between Oval and Footer -->
        <LinearLayout
            android:id="@+id/layout_middle_guidance"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@+id/layout_scan_footer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/frame_oval_wrapper">

            <TextView
                android:id="@+id/tv_scan_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.005"
                android:lineSpacingMultiplier="1.12"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/face_verify_instruction_turn_head"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_scan_substatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:textColor="#9CA3AF"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Action Buttons (shown on timeout/error) -->
            <LinearLayout
                android:id="@+id/layout_scan_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scan_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="@color/brand_primary"
                    android:text="@string/face_id_retry"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    app:cornerRadius="22dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ResQTap Footer Branding -->
        <LinearLayout
            android:id="@+id/layout_scan_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/resqtap_launcher_cropped" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ResQTap Real Identity"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
