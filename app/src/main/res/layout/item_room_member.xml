<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/member_card_bg"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/member_card_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="104dp"
        android:padding="12dp">

        <View
            android:id="@+id/sos_blink"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0"
            android:visibility="gone"
            android:background="@drawable/bg_sos_blink"
            app:layout_constraintStart_toStartOf="@id/avatar"
            app:layout_constraintTop_toTopOf="@id/avatar" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/avatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_avatar_dark"
            android:contentDescription="@null"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_avatar"
            android:tint="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ResQTap.Circle"
            tools:src="@drawable/ic_avatar" />

        <TextView
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/member_name_text"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@id/status_actions"
            app:layout_constraintStart_toEndOf="@id/avatar"
            app:layout_constraintTop_toTopOf="@id/avatar"
            tools:text="Aina Binti Ahmad" />

        <LinearLayout
            android:id="@+id/status_actions"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/avatar">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bell_pill"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                app:cardBackgroundColor="@color/member_pill_bg"
                app:cardCornerRadius="999dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/member_card_stroke"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/bell_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Bell"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/member_pill_tint" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/battery_pill"
                android:layout_width="74dp"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                app:cardBackgroundColor="@color/member_pill_bg"
                app:cardCornerRadius="999dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/member_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/battery_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/member_name_text"
                        android:textSize="12sp"
                        tools:text="100%" />

                    <ImageView
                        android:id="@+id/battery_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_battery"
                        app:tint="@color/member_name_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/remove_pill"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                app:cardBackgroundColor="@color/member_pill_bg"
                app:cardCornerRadius="999dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/member_card_stroke"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/remove_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:text="-"
                    android:textColor="@color/member_pill_tint"
                    android:textSize="20sp"
                    android:includeFontPadding="false" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/direction_pill"
            style="@style/Widget.ResQTap.FilledButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minHeight="32dp"
            android:layout_marginTop="16dp"
            android:text="@string/direction"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            app:cornerRadius="999dp"
            app:layout_constraintTop_toBottomOf="@id/status_actions"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/meta_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/direction_pill"
            app:layout_constraintStart_toEndOf="@id/avatar"
            app:layout_constraintTop_toBottomOf="@id/name">

            <TextView
                android:id="@+id/online_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/success_green"
                android:textSize="12sp"
                tools:text="Online" />

            <TextView
                android:id="@+id/dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="&#8226;"
                android:textColor="@color/member_subtext"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/last_seen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/member_subtext"
                android:textSize="12sp"
                tools:text="Seen 2 min ago" />
        </LinearLayout>

        <TextView
            android:id="@+id/address_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/member_subtext"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/direction_pill"
            app:layout_constraintStart_toEndOf="@id/avatar"
            app:layout_constraintTop_toBottomOf="@id/meta_row"
            tools:text="Jalan Tun Dr Awang, Bukit Mertajam" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
